<form class="pneuma-area-editor" autocomplete="off">
  <div class="pneuma-area-editor-body">
    <p class="notes">Choose an attack type to edit. Distances are in m/yd; widths are in scene squares.</p>
    {{#each profiles}}
    <details class="pneuma-area-profile" data-area-profile="{{prefix}}" {{#if @first}}open{{/if}}>
      <summary><span>{{label}}</span><output data-area-summary="{{prefix}}" aria-live="polite"></output></summary>
      <div class="pneuma-area-profile-body">
      <p class="notes">{{hint}}</p>
      <div class="pneuma-area-fields">
        <div class="form-group"><label for="pct-{{prefix}}-shape">Shape</label><select id="pct-{{prefix}}-shape" name="{{prefix}}Shape">{{selectOptions shapes selected=shape}}</select></div>
        <div class="form-group"><label for="pct-{{prefix}}-size">Side length (m/yd)</label><input id="pct-{{prefix}}-size" type="number" name="{{prefix}}Size" value="{{size}}" min="1" max="100" step="any"></div>
        {{#if blast}}<div class="form-group"><label for="pct-blast-radius">Radius (m/yd)</label><input id="pct-blast-radius" type="number" name="blastRadius" value="{{radius}}" min="1" max="100" step="any"></div>{{else}}
        <div class="form-group"><label for="pct-{{prefix}}-range">{{rangeLabel}} (m/yd)</label><input id="pct-{{prefix}}-range" type="number" name="{{prefix}}Range" value="{{range}}" min="1" max="500" step="any"></div>
        <div class="form-group"><label for="pct-{{prefix}}-angle">Angle (degrees)</label><input id="pct-{{prefix}}-angle" type="number" name="{{prefix}}Angle" value="{{angle}}" min="1" max="179" step="any"><div class="pneuma-area-presets" aria-label="Cone angle presets"><button type="button" data-area-field="{{prefix}}Angle" data-area-value="45">45°</button><button type="button" data-area-field="{{prefix}}Angle" data-area-value="90">90°</button></div></div>
        <div class="form-group"><label for="pct-{{prefix}}-width">Width (squares)</label><input id="pct-{{prefix}}-width" type="number" name="{{prefix}}Width" value="{{width}}" min="1" max="25" step="any"><div class="pneuma-area-presets" aria-label="Ray width presets"><button type="button" data-area-field="{{prefix}}Width" data-area-value="1">1 square</button><button type="button" data-area-field="{{prefix}}Width" data-area-value="3">3 squares</button></div></div>
        {{/if}}
        {{#if suppression}}<div class="form-group"><label for="pct-corridor-max">Ray range (m/yd)</label><input id="pct-corridor-max" type="number" name="corridorMax" value="{{rayRange}}" min="0" max="1000" step="any"><small>0 = to the scene boundary</small></div>{{/if}}
      </div>
      </div>
    </details>
    {{/each}}
    <p class="notes">Areas respect walls. These distances set the affected area, not weapon range.</p>
    <details class="pneuma-area-rules"><summary>Evasion &amp; Cover Up</summary>
      <p class="notes">Successful evaders must leave the area. MOVE costs and borrowing are optional homebrew.</p>
      <div class="form-group"><label for="pct-evade-move">Charge evasion movement to MOVE</label><input id="pct-evade-move" type="checkbox" name="evadeMove" {{checked evadeMove}}></div>
      <div class="form-group"><label for="pct-evade-borrow">Borrow remaining cost from next turn</label><input id="pct-evade-borrow" type="checkbox" name="evadeBorrow" {{checked evadeBorrow}}></div>
      <div class="form-group"><label for="pct-evade">Evasion eligibility</label><select id="pct-evade" name="evade">{{selectOptions evadeChoices selected=evade}}</select></div>
      <div class="form-group"><label for="pct-evade-penalty">Evasion modifier</label><input id="pct-evade-penalty" type="number" name="evadePenalty" value="{{evadePenalty}}" min="-20" max="20"></div>
      <div class="form-group"><label for="pct-cover-up" data-cover-up-label>Allow Cover Up Homebrew</label><input id="pct-cover-up" type="checkbox" name="coverUp" {{checked coverUp}}></div>
      <p class="notes">Cover Up: stay in place, become Prone, double armor SP for this damage application, and double armor ablation even if no damage penetrates. RAW explosive evasion must exceed the attack. Shell defense ties avoid the attack.</p>
    </details>
  </div>
  <footer class="sheet-footer flexrow"><button type="submit"><i class="fas fa-save" aria-hidden="true"></i> Save AoE settings</button></footer>
</form>
