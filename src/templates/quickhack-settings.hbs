<form autocomplete="off">
  <div class="form-group"><label for="qh-require-neuroport">Hide QuickHack menu without installed Neuroport</label><div class="form-fields"><input id="qh-require-neuroport" type="checkbox" name="requireNeuroport" {{checked requireNeuroport}}></div></div>
  <p class="notes">Hide the target QuickHack menu unless the target has installed Neuroport cyberware. Applies to all players and GMs.</p>
  <div class="form-group"><label>Rules mode</label><div class="form-fields"><select name="mode">{{selectOptions modes selected=mode}}</select></div></div>
  <p class="notes">NPC attack rolls and NPC-to-NPC results are GM-blind. Undetected NPC Jack-In results remain GM-only. Player attack rolls are public.</p>
  {{#each groups}}
  <fieldset><legend>{{title}}</legend>
  {{#each rows}}
  <div class="form-group"><label for="qh-{{key}}">{{title}}</label><div class="form-fields"><select id="qh-{{key}}" name="{{key}}">{{selectOptions choices selected=value}}</select></div></div>
  {{/each}}
  </fieldset>
  {{/each}}
  <footer class="sheet-footer flexrow"><button type="submit"><i class="fas fa-save"></i> {{localize 'Save'}}</button></footer>
</form>
