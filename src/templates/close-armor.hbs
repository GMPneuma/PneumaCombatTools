<form><table><thead><tr><th>Attack type</th><th>Half Armor</th><th>Ablate Armor</th></tr></thead><tbody>
{{#each rows}}<tr><th scope="row">{{label}}</th><td><input type="checkbox" name="{{key}}Half" aria-label="{{label}} half armor" {{checked half}}></td><td><input type="checkbox" name="{{key}}Ablate" aria-label="{{label}} ablate armor" {{checked ablate}}></td></tr>{{/each}}
</tbody></table><footer class="sheet-footer"><button type="submit">Save</button></footer></form>
