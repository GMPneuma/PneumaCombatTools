<form autocomplete="off">
  <p class="notes">GM settings for all players. Play previews your current choices only on this client. Leave a file blank or set volume to 0 to mute it.</p>
  {{#each sounds}}
  <fieldset>
    <legend>{{label}}</legend>
    <div class="form-group"><label>Sound file</label><div class="form-fields"><input type="text" name="{{pathKey}}" value="{{path}}">{{filePicker type="audio" target=pathKey}}</div></div>
    <div class="form-group"><label>Volume</label><div class="form-fields"><input type="range" name="{{volumeKey}}" value="{{volume}}" min="0" max="1" step="0.05"><span class="range-value">{{volume}}</span><button type="button" data-play-sound><i class="fas fa-play" aria-hidden="true"></i> Play</button></div></div>
  </fieldset>
  {{/each}}
  <footer class="sheet-footer flexrow"><button type="submit"><i class="fas fa-save" aria-hidden="true"></i> Save</button></footer>
</form>
